# Step 17: environments — copy to `.env.dev` (local dev) and fill in.
# The app loads `.env.<APP_ENV>` first, then `.env`.
#   flutter run                                  # dev  (`.env.dev` -> `.env`)
#   flutter run --dart-define=APP_ENV=prod \    # prod (`.env.prod` -> CI keys)
#     --dart-define=SUPABASE_URL=... \
#     --dart-define=SUPABASE_ANON_KEY=...
# `--dart-define` always wins over files (use it in CI so prod secrets
# never live in a file). `.env*` is gitignored — never commit real keys.
APP_ENV=dev
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
